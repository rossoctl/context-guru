[0.3, "o", "\u001b[38;5;246m\u001b[48;5;237m❯\u001b[39m \u001b[38;5;231m/context-guru:remove-mcp-and-skills\u001b[39m\r\n\r\n\u001b[49m  \u001b[38;5;246mRan \u001b[1m1\u001b[0m\u001b[38;5;246m\u001b[49m shell command \u001b[39m\r\n\u001b[38;5;246m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\n\u001b[38;5;16m\u001b[48;5;153m ☐ Remove items \u001b[39m\u001b[49m\r\n\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m \u001b[1m\u001b[38;5;231mRemove these 6 items? Over the last 30 days they would have saved about $7.33 a week (pays back in about 2 \u001b[0m\u001b[39m\u001b[49m\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m \u001b[1m\u001b[38;5;231mweeks).\u001b[0m\u001b[39m\u001b[49m\r\n\r\n\u001b[38;5;153m❯\u001b[39m \u001b[38;5;246m1.\u001b[39m \u001b[38;5;153mYes, remove them\u001b[39m\r\n     \u001b[38;5;246mmcp__playwright, mcp__figma, skill__brand-voice, sentry__list_releases, skill__pdf-export, \u001b[39m\r\n     \u001b[38;5;246mskill__changelog\u001b[39m\r\n  \u001b[38;5;246m2.\u001b[39m No, keep them\r\n     \u001b[38;5;246mKeep everything; do not apply the recommended filters.\u001b[39m\r\n  \u001b[38;5;246m3. Type something.\u001b[39m\r\n\u001b[38;5;246m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\n\u001b[39m  4. Chat about this\r\n\r\n\u001b[38;5;246mEnter to select · ↑/↓ to navigate · Esc to cancel\u001b[39m\r\n"]
