[0.3, "o", "\u001b[38;5;246m\u001b[48;5;237m❯\u001b[39m \u001b[38;5;231m/context-guru:save-more\u001b[39m\r\n\r\n\u001b[49m  \u001b[38;5;246mRan \u001b[1m1\u001b[0m\u001b[38;5;246m\u001b[49m shell command \u001b[39m\r\n\u001b[38;5;246m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\n\u001b[38;5;16m\u001b[48;5;153m ☐ Apply? \u001b[39m\u001b[49m\r\n\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m \u001b[1m\u001b[38;5;231mApply both recommended changes?\u001b[0m\u001b[39m\u001b[49m\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m \u001b[1m\u001b[38;5;231mRecommended: preset conservative -> medium (takes effect now).\u001b[0m\u001b[39m\u001b[49m\r\n\u001b[2m│\u001b[0m\u001b[39m\u001b[49m \u001b[1m\u001b[38;5;231mRecommended: cache strategy 5-min-ping -> adaptive (takes effect at the next proxy restart).\u001b[0m\u001b[39m\u001b[49m\r\n\r\n\u001b[38;5;153m❯\u001b[39m \u001b[38;5;246m1.\u001b[39m \u001b[38;5;153mApply both\u001b[39m\r\n     \u001b[38;5;246mApply both the config change (conservative -> medium) and the cache change (5-min-ping -> adaptive).\u001b[39m\r\n  \u001b[38;5;246m2.\u001b[39m Only config\r\n     \u001b[38;5;246mApply only the config change: preset conservative -> medium (takes effect now).\u001b[39m\r\n  \u001b[38;5;246m3.\u001b[39m Only cache\r\n     \u001b[38;5;246mApply only the cache change: cache strategy 5-min-ping -> adaptive (takes effect at the next proxy \u001b[39m\r\n     \u001b[38;5;246mrestart).\u001b[39m\r\n  \u001b[38;5;246m4.\u001b[39m Neither\r\n     \u001b[38;5;246mDo not apply either recommended change.\u001b[39m\r\n  \u001b[38;5;246m5. Type something.\u001b[39m\r\n\u001b[38;5;246m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\n\u001b[39m  6. Chat about this\r\n\r\n\u001b[38;5;246mEnter to select · ↑/↓ to navigate · Esc to cancel\u001b[39m\r\n"]
