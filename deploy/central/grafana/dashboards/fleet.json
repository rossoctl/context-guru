{
  "uid": "central-fleet",
  "title": "Fleet overview",
  "description": "Do we save money, and is the fleet healthy? Tokens are the same for every proxy. Money is each proxy's own rate table.",
  "tags": [
    "central",
    "fleet"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "proxy",
        "label": "Proxy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info, proxy)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info{proxy=~\"$proxy\"}, machine)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "NET SAVED",
      "description": "Saved minus added over the selected range. This is the number that says whether the proxy pays. Cache effects are a breakdown and are not added.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "(sum(increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])) - sum(increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "no data",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 56
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gross saved",
      "description": "Cost the proxy removed, before what it cost to do so.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "no data",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Added cost",
      "description": "What the proxy's own work cost: its model calls and the cache writes it caused.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "no data",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spend",
      "description": "What the providers billed over the selected range. Each proxy prices with its own rate table.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_cost_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "no data",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Net saved per day",
      "description": "One bar per day, for 30 days whatever the dashboard range. A bar below zero is a day the proxy cost more than it saved.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "(sum(increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[1d])) - sum(increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[1d])))",
          "legendFormat": "net",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          },
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "xTickLabelRotation": 0
      },
      "timeFrom": "30d"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Saved vs added (USD per hour)",
      "description": "Both sides of the net, as a rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 3600",
          "legendFormat": "saved",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        },
        {
          "expr": "sum(rate(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 3600",
          "legendFormat": "added",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "saved"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "added"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Net saved by machine",
      "description": "The 8 best machines over the selected range. The full list is on the Machine comparison dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(8, (((sum by (machine)(increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))) or (sum by (machine)(increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))) * 0) - ((sum by (machine)(increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))) or (sum by (machine)(increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))) * 0)))",
          "legendFormat": "{{machine}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#73BF69",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Machines reporting",
      "description": "Machines that pushed in the last few minutes. llm_proxy_info is always 1, so an idle machine still counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (machine) (llm_proxy_info{proxy=~\"$proxy\", machine=~\"$machine\"}))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Silent machines",
      "description": "Machines that pushed in the last day and have pushed nothing for a few minutes. The alert MachineSilent fires after 15.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 5,
        "y": 20,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(max by (proxy, machine) (max_over_time(llm_proxy_info{proxy=~\"$proxy\", machine=~\"$machine\"}[1d])) unless max by (proxy, machine) (llm_proxy_info{proxy=~\"$proxy\", machine=~\"$machine\"})) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FADE2A"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "5xx error rate",
      "description": "Server errors only. A 4xx is usually the client's own request.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 10,
        "y": 20,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_requests_total{proxy=~\"$proxy\", machine=~\"$machine\",status_class=\"5xx\"}[$__range])) / clamp_min(sum(increase(llm_inference_requests_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])), 1)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Requests per minute",
      "description": "Requests that reached all proxies.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 15,
        "y": 20,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(llm_inference_requests_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 60",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alerts that Prometheus has in the firing state. The list is in Alertmanager.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    }
  ]
}
