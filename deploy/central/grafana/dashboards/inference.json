{
  "uid": "central-inference",
  "title": "Inference",
  "description": "What do the models consume, and how fast do they answer?",
  "tags": [
    "central",
    "inference"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "proxy",
        "label": "Proxy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info, proxy)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info{proxy=~\"$proxy\"}, machine)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Input tokens",
      "description": "Fresh prompt tokens, not read from cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=\"input\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache read tokens",
      "description": "Prompt tokens read from the cache (cheap).",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=\"cache_read\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache write tokens",
      "description": "Prompt tokens written to the cache (a premium over input).",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=~\"cache_write_5m|cache_write_1h\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Output tokens",
      "description": "Tokens the model wrote.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=\"output\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache read ratio",
      "description": "cache_read / (cache_read + cache_write + input).",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=\"cache_read\"}[$__range])) / clamp_min(sum(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=~\"cache_read|cache_write_5m|cache_write_1h|input\"}[$__range])), 1)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens per hour, by tier",
      "description": "Provider-billed tokens per hour. Tokens are the same for every proxy, so this is comparable where money is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (tier)(rate(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_write_5m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_write_1h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Tokens by model (selected range)",
      "description": "Total tokens, all tiers, per model.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (model)(increase(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#73BF69",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time to first token (seconds)",
      "description": "Time from request to the first byte of a streamed answer. A buffered stream has no true first byte and is left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_inference_ttfb_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_inference_ttfb_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_inference_ttfb_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Time to first token p95 by model (seconds)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_inference_ttfb_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Output tokens per streamed request",
      "description": "Not a speed. Output tokens divided by streamed requests, by model. A true tokens per second needs the time spent writing, which is not recorded.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (model)(rate(llm_inference_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\",tier=\"output\"}[$__rate_interval])) / clamp_min(sum by (model) (rate(llm_inference_requests_total{proxy=~\"$proxy\", machine=~\"$machine\",stream=\"true\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Time the proxy added (seconds)",
      "description": "What the proxy's own work added on top of the upstream time (R46).",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_inference_added_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_inference_added_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_inference_added_seconds_bucket{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Spend per hour, by model",
      "description": "Provider cost at request time. Each proxy prices with its own rate table.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (model)(rate(llm_inference_cost_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Spend priced from a fallback rate",
      "description": "Share of spend where the model had no rate of its own. A high value means the money panels are a guess.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(llm_inference_estimated_cost_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])) / clamp_min(sum(increase(llm_inference_cost_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])), 1e-9)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FADE2A"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 56
        }
      }
    }
  ]
}
