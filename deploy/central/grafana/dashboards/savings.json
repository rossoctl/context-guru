{
  "uid": "central-savings",
  "title": "Savings",
  "description": "Where does the saving come from, and where does it leak?",
  "tags": [
    "central",
    "savings"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "proxy",
        "label": "Proxy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info, proxy)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "central-prom"
        },
        "query": {
          "query": "label_values(llm_proxy_info{proxy=~\"$proxy\"}, machine)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Net by component (USD, selected range)",
      "description": "Saved minus added for each component. A negative bar is a component that costs more than it saves.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (component) (increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])) - sum by (component) (increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))",
          "legendFormat": "{{component}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Components with negative net",
      "description": "Only the components below zero. Candidates to turn off (#670).",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "(sum by (component) (increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])) - sum by (component) (increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range]))) < 0",
          "legendFormat": "{{component}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Net by kind",
      "description": "rewrite, spend and setting. A spend is a component's own model call and is always a cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(llm_savings_saved_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) - sum by (kind) (increase(llm_savings_added_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Saved tokens by tier",
      "description": "Tokens per minute. The tier decides the price of each token.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tier) (rate(llm_savings_saved_tokens_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 60",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache effects (USD per hour)",
      "description": "A breakdown of how the cache changed the bill. It is never added to saved or added.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (effect, direction) (rate(llm_savings_cache_effect_usd_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{effect}} {{direction}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Break cost by cause",
      "description": "What cache breaks cost, by why they happened.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (cause) (increase(llm_savings_cache_effect_usd_total{proxy=~\"$proxy\", machine=~\"$machine\",effect=\"break\",direction=\"added\"}[$__range]))",
          "legendFormat": "{{cause}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Estimated share",
      "description": "Share of requests whose figure is an estimate. Above 20 percent, read the headline as a range.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(llm_savings_estimated_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])) / clamp_min(sum(increase(llm_savings_requests_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__range])), 1)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Unpriced requests by reason",
      "description": "Operations the accountant did not price, and why. Per minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "central-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 25,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(llm_savings_unpriced_total{proxy=~\"$proxy\", machine=~\"$machine\"}[$__rate_interval])) * 60",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "central-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
