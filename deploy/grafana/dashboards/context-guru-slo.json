  {
   "id": 14,
   "type": "stat",
   "title": "Refusal rate, 24 hours",
   "description": "Refused requests over all requests (refused plus processed \u2014 a refused request never reaches the aggregator, so it is not in cg_requests_total). This is the error-rate SLI: above 1% somebody's agent is failing repeatedly, above 5% treat it as an outage for whoever is being refused. Break it down by reason on the panel to the right.",
   "datasource": {
    "type": "prometheus",
    "uid": "cg-prom"
   },
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
     },
     "expr": "sum(increase(cg_refused_requests_total[24h])) / clamp_min(sum(increase(cg_refused_requests_total[24h])) + sum(increase(cg_requests_total[24h])), 1)",
     "editorMode": "code",
     "legendFormat": "refused",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#199e70",
        "value": null
       },
       {
        "color": "#c98500",
        "value": 0.01
       },
       {
        "color": "#e66767",
        "value": 0.05
       }
