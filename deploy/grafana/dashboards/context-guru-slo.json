  {
   "id": 2,
   "type": "stat",
   "title": "Availability, 30 days",
   "description": "Fraction of scrapes where the proxy answered. Below 99.9% over 30 days is roughly 43 minutes of outage \u2014 the point where a monthly target is already spent. Reads a flattering 100% until Prometheus has actually retained 30 days of history.",
   "datasource": {
    "type": "prometheus",
    "uid": "cg-prom"
   },
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
     },
     "expr": "avg_over_time(up{job=\"context-guru\"}[30d])",
     "editorMode": "code",
     "legendFormat": "30d",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#e66767",
        "value": null
       },
       {
        "color": "#c98500",
        "value": 0.99
       },
       {
        "color": "#199e70",
        "value": 0.999
       }
      ]
     },
     "decimals": 3,
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto"
   }
  },
