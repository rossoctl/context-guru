  {
   "id": 16,
   "type": "timeseries",
   "title": "Open file descriptors",
   "description": "Allocated file descriptors against the kernel limit. Every in-flight request holds a socket to the upstream, so an fd count that climbs and never falls is a leak that ends in refused connections.",
   "datasource": {
    "type": "prometheus",
    "uid": "cg-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
     },
     "expr": "node_filefd_allocated{job=\"node\"}",
     "editorMode": "code",
     "legendFormat": "allocated"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
     },
     "expr": "node_filefd_maximum{job=\"node\"}",
     "editorMode": "code",
     "legendFormat": "maximum"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Context switches and forks",
   "description": "Scheduler pressure. A jump with no traffic change points at a neighbour on the box rather than at agent load.",
   "datasource": {
    "type": "prometheus",
    "uid": "cg-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
     },
     "expr": "rate(node_context_switches_total{job=\"node\"}[5m])",
     "editorMode": "code",
     "legendFormat": "context switches/s"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "cg-prom"
