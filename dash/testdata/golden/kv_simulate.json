   "selectable": true,
   "unreachable": false
  }
 ],
 "assumptions": {
  "formulas": [
   {
    "formula": "input_tokens × input_rate",
    "name": "Uncached input",
    "note": "A prompt with no cache_control at all: every token billed once, at the fresh rate."
   },
   {
    "formula": "cache_read_tokens × cache_read_rate",
    "name": "Cache read",
    "note": "A hit. The read rate defaults to 0.1× input, and a read refreshes the entry's lifetime for no extra charge."
   },
   {
    "formula": "written_tokens × write_5m_rate",
    "name": "Cache write, 5-minute TTL",
    "note": "Creating an entry that lives five minutes. Defaults to 1.25× input."
   },
   {
    "formula": "written_tokens × write_1h_rate",
    "name": "Cache write, 1-hour TTL",
    "note": "Creating an entry that lives an hour. Defaults to 2.0× input — no gateway publishes this rate, so it is derived from the multiplier and editable above."
   },
   {
    "formula": "cached_tokens × cache_read_rate + ping_input × input_rate + ping_output × output_rate",
    "name": "Keep-alive ping",
    "note": "One refresh. It is a cache READ, so a five-minute and a one-hour keep-alive cost the same per ping; what differs is the creation tier that put the entry there and how often a ping is needed."
   },
   {
    "formula": "cached_tokens × write_rate(tier) + ping_input × input_rate + ping_output × output_rate",
    "name": "Keep-alive that arrived late",
    "note": "A ping that fires after the entry lapsed re-creates it, at 12.5× a read for the 5-minute tier and 20× for the 1-hour one. Counted as pings_that_rewrote."
   },
   {
    "formula": "uncached_input + cache_read + cache_write + output",
    "name": "Request cost",
    "note": "One request's whole bill under a simulated strategy."
   },
   {
    "formula": "Σ request_cost + Σ ping_cost",
    "name": "Total cost",
    "note": "One strategy's whole bill."
   },
   {
    "formula": "total_cost − uncached_cost",
    "name": "Incremental cache premium",
    "note": "What the caching machinery itself cost, separate from the bill it sits inside. NEGATIVE means the cache paid for itself."
   },
   {
    "formula": "baseline_cost − strategy_cost",
    "name": "Absolute savings",
    "note": "Negative where the strategy costs more, and shown that way — never clamped to zero."
   },
   {
    "formula": "absolute_savings ÷ baseline_cost × 100",
    "name": "Percentage savings",
    "note": "Undefined, not 0%, when the baseline is zero."
   },
   {
    "formula": "write_1h_usd − write_5m_usd",
    "name": "Raising the TTL from five minutes to an hour",
    "note": "What the longer hold costs, on the SAME write — the price of the extra 45 minutes of coverage, before anything it might save is counted."
   },
   {
    "formula": "late_5m_usd − keep_alive_usd",
    "name": "Saved per prevented miss",
    "note": "What one five-minute miss costs beyond what a hit at the same tier would have. The ping overhead is in both terms and cancels, leaving the write-versus-read gap."
   },
   {
    "formula": "late_5m_usd − write_1h_usd",
    "name": "One 5m miss vs one 1h write",
    "note": "SIGNED. Negative means paying for the 1-hour tier up front costs more than eating the one five-minute miss it would have prevented."
   },
   {
    "formula": "⌈raise_5m_to_1h_usd ÷ saved_per_miss_usd⌉",
    "name": "Prevented misses to break even",
    "note": "How many five-minute misses raising the TTL has to prevent before it pays for itself. Undefined, not zero, when saved_per_miss_usd is not positive."
   }
  ],
  "horizon_1h_seconds": 3600,
  "horizon_5m_seconds": 300,
  "multipliers": {
   "cache_read": 0.1,
   "write_1h": 2,
   "write_5m": 1.25
  },
  "notes": [
   "Every timestamp, hour and time-of-day band on this page is UTC. The store carries no per-user timezone, so a local one would be invented.",
   "A conversation is (account, session, model). The account is in the key because a session id is client-supplied and can collide between accounts; the MODEL is in it because a cache entry does not transfer between models, so a request on one model cannot read another model's entry and the two are not each other's successor.",
   "A request with no next request in the same conversation has NO idle time. It is counted separately and excluded from every average, never treated as a zero gap.",
   "Keep-alive ping rows written by context-guru itself are excluded from this dataset: counted, they would split one real idle gap into two short ones.",
   "A cache miss recorded as prefix_change or cold_start cannot be rescued by any TTL. Those rows force a miss in every simulated arm and are reported as forced_misses.",
   "Requests whose token accounting was incomplete have an UNKNOWN cost and contribute nothing to any dollar figure. They are counted, never valued at zero.",
   "The one-hour write rate is derived from a multiplier because no gateway publishes one. Both the multiplier and the resulting rate are editable above.",
   "A ping cannot generate nothing on a provider that requires max_tokens ≥ 1, so its minimum output is priced and stated rather than rounded away.",
   "Latency avoided is derived from THIS window's own means: the mean upstream time of requests that really missed, minus that of requests that really hit. It is absent where either population is under 20 rows."
  ],
  "schedule": {
   "idle_seconds": 280,
   "idle_seconds_1h": 3360,
   "max_pings": 2
  },
  "semantics": {
   "hit_refreshes_ttl": true,
   "ping_refreshes_ttl": true,
   "zero_generation": false
  },
  "time_unit": "milliseconds",
  "time_zone": "UTC"
 },
